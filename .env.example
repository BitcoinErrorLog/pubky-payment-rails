# Copy to `.env` (gitignored) and fill in. Never commit real values.
# Load with: node --env-file=.env verify/driver.mjs <command> ...

# Path to a package.json that can resolve @synonymdev/pubky
# (any checkout that has it installed, e.g. pubky-app). Relative paths
# resolve from the working directory.
PUBKY_SDK_REQUIRE=../pubky-app/package.json

# Staging homeserver z32 public key (required for `signup`).
STAGING_HOMESERVER=replace-with-staging-homeserver-z32

# Preferred identities: 32-byte base64url secrets from `gen`.
# CREATOR_SECRET_FILE=./verify/ids/creator.secret
# READER_SECRET_FILE=./verify/ids/reader.secret

# Recovery-file identities (used only when the matching *_SECRET_FILE is unset).
# CREATOR_RECOVERY_FILE=./verify/ids/creator.pkarr
# READER_RECOVERY_FILE=./verify/ids/reader.pkarr
# RECOVERY_PASSWORD=replace-with-recovery-passphrase

# Wallet-leg: public keys only (z32, optional `pubky` prefix). Skip holding
# secrets in the driver when these are set for roleZ32 lookups.
# CREATOR_PUBKY=replace-with-creator-z32
# READER_PUBKY=replace-with-reader-z32
# SELLER_PUBKY=replace-with-seller-z32
# BUYER_PUBKY=replace-with-buyer-z32

# Deployed Lock Server (required for `publish` / `status`).
LOCKS_PUBLIC_KEY=replace-with-lock-server-pubky
LOCKS_SEED_B64URL=replace-with-locks-seed-base64url-no-prefix

# Public HTTPS endpoints of the deployed rails (optional; driver defaults match).
# LOCKS_URL=https://locks-server-production.up.railway.app
# PAYKIT_URL=https://paykit-server-production.up.railway.app
# FIAT_URL=https://fiat-verifier-production.up.railway.app
# RETURN_ORIGIN=https://shop.pubky.app

# Wallet-leg operator notes (not read by driver.mjs).
# SELLER_UDID=replace-with-seller-simulator-udid
# BUYER_UDID=replace-with-buyer-simulator-udid
# FULCRUM_PUBLIC_HOST=replace-with-fulcrum-public-host
# FULCRUM_PUBLIC_PORT=replace-with-fulcrum-public-port
# WALLET_LEG_EVIDENCE_DIR=./wallet-leg-evidence
